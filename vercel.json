{
  "headers": [
    { "source": "/spot-views/:asset([a-f0-9]{20}\\.jpg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/spot-views/:asset([a-f0-9]{20}\\.png)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/spot-views/manifest.json", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] }
  ],
  "rewrites": [
    { "source": "/soleil/privacy", "destination": "/index.html" },
    { "source": "/soleil/privacy/", "destination": "/index.html" },
    { "source": "/soleil/support", "destination": "/index.html" },
    { "source": "/soleil/support/", "destination": "/index.html" }
  ]
}
