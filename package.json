{
  "name": "soleil",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/finalize-pwa.mjs",
    "native:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:archive:verify": "node scripts/verify-ios-archive.mjs",
    "ios:release:verify": "node scripts/verify-app-store-readiness.mjs",
    "ios:verify": "npm run native:sync && node scripts/verify-ios-shell.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:pwa": "npm run build && npm run test:pwa:artifact",
    "test:pwa:artifact": "playwright test --config playwright.pwa.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/app-launcher": "8.0.1",
    "@capacitor/core": "8.5.0",
    "@capacitor/ios": "8.5.0",
    "@capacitor/preferences": "8.0.1",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@maplibre/maplibre-gl-leaflet": "0.1.3",
    "@tailwindcss/vite": "^4.2.2",
    "@types/leaflet": "^1.9.21",
    "@types/suncalc": "^1.9.2",
    "html-to-image": "^1.11.13",
    "leaflet": "^1.9.4",
    "maplibre-gl": "5.17.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-leaflet": "^5.0.0",
    "suncalc": "^1.9.0",
    "supercluster": "^8.0.1",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "8.5.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^4.1.8"
  }
}
